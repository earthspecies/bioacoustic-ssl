# Site-local Hydra launchers. `configs/hydra/launcher/slurm.yaml` is the tracked,
# env-driven one; anything a specific cluster needs on top (per-job venv, module
# loads, scratch mounts) stays here and out of the repo.
configs/hydra/launcher/gpu.yaml
configs/hydra/launcher/gpu_h100.yaml
configs/hydra/launcher/*.local.yaml

# Site-local sbatch wrappers: partitions, node lists, scratch venvs, one-off
# resubmits. The tracked, generic ones live in scripts/slurm/examples/.
scripts/slurm/*
!scripts/slurm/examples
