# Template for the repo .env. Copy to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored. Loaded by Python entry points (load_dotenv()) and by the
# slurm scripts (`set -a; source .env; set +a`).

# --- Secrets ---------------------------------------------------------------
WANDB_API_KEY="your-wandb-api-key"
EARTHDATA_USERNAME="your-earthdata-username"
EARTHDATA_PASSWORD="your-earthdata-password"
A2O_EMAIL="you@example.org"
A2O_PASSWORD="your-a2o-password"

# --- HuggingFace cache -----------------------------------------------------
HF_HOME="${HOME}/.cache/huggingface"
HF_DATASETS_CACHE="${HOME}/.cache/datasets"
HF_HUB_CACHE="${HOME}/.cache/hub"

# --- W&B (all optional) ----------------------------------------------------
# Unset entity logs to the API key's own default entity, which is what a fresh
# clone wants. WANDB_MODE=offline (or disabled) runs without a network call.
# WANDB_ENTITY="your-team"
# WANDB_PROJECT="soundscape_ssl"
# WANDB_MODE="online"

# --- Paths (all optional) --------------------------------------------------
# Defaults: PROJECT_ROOT = the launch directory, CKPT_DIR = <root>/checkpoints.
# Set CKPT_DIR to read pretraining checkpoints off a shared/scratch mount.
# PROJECT_ROOT="${HOME}/bioacoustic-ssl"
# CKPT_DIR="/scratch/checkpoints"

# --- Slurm launcher (configs/hydra/launcher/slurm.yaml, all optional) ------
# Resources for the GPU jobs a `--multirun ... hydra/launcher=slurm` fans out.
# Prefixed on purpose: Slurm sets SLURM_PARTITION / SLURM_CPUS_PER_TASK itself
# inside an allocation, which a sweep would otherwise inherit silently.
# SLURM_LAUNCHER_PARTITION="gpu"
# SLURM_LAUNCHER_CPUS=8
# SLURM_LAUNCHER_MEM_GB=120
# SLURM_LAUNCHER_GRES="gpu:1"
# SLURM_LAUNCHER_TIMEOUT_MIN=2880
# SLURM_LAUNCHER_PARALLELISM=3
# SLURM_LAUNCHER_ACCOUNT=""
# SLURM_LAUNCHER_QOS=""
# SLURM_LAUNCHER_CONSTRAINT=""
# SLURM_LAUNCHER_EXCLUDE=""
# Swap in a site-local launcher file (gitignored) instead of the tracked one:
# HYDRA_LAUNCHER="gpu_h100"

# --- Misc ------------------------------------------------------------------
HYDRA_FULL_ERROR="1"
