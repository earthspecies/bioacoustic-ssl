# Template for the repo .env. Copy to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored. Loaded by Python entry points (load_dotenv()) and by the
# slurm scripts (`set -a; source .env; set +a`).

# --- Secrets ---------------------------------------------------------------
WANDB_API_KEY="your-wandb-api-key"
HF_TOKEN="hf_xxxxxxxxxxxxxxxxxxxxxxxx"
EARTHDATA_USERNAME="your-earthdata-username"
EARTHDATA_PASSWORD="your-earthdata-password"
A2O_EMAIL="you@example.org"
A2O_PASSWORD="your-a2o-password"

# --- TLS / CA bundle (persistent OS bundle; the /scratch venv copy is ephemeral) ---
SSL_CERT_FILE="/etc/ssl/certs/ca-certificates.crt"
REQUESTS_CA_BUNDLE="/etc/ssl/certs/ca-certificates.crt"

# --- HuggingFace cache -----------------------------------------------------
HF_HOME="${HOME}/.cache/huggingface"
HF_DATASETS_CACHE="${HOME}/.cache/datasets"
HF_HUB_CACHE="${HOME}/.cache/hub"

# --- Misc ------------------------------------------------------------------
HYDRA_FULL_ERROR="1"
